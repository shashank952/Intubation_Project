APP_NAME=Airway Assessment API
APP_VERSION=2.0.0
DEBUG=false

MONGO_URL=mongodb://mongo:27017
MONGO_DB=airway_db

JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

OLLAMA_URL=http://llm:11434/api/generate
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

MODEL_CHECKPOINT=checkpoints/tabular_best.pt
MODEL_DEVICE=cpu

# Face model for /api/images/analyze. Empty = ~/.cache/yolo-face/yolo26n-face.pt
FACE_MODEL_PATH=
