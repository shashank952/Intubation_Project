APP_NAME=Airway Assessment API
APP_VERSION=2.0.0
DEBUG=false

MONGO_URL=mongodb://mongo:27017
MONGO_DB=airway_db

# Use a strong random secret (e.g. `openssl rand -hex 32`). Required in production.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
# Set false to disable the external LLM (falls back to canned clinical text).
LLM_EXTERNAL_ENABLED=true

MODEL_CHECKPOINT=checkpoints/tabular_best.pt
MODEL_DEVICE=cpu

# Set true only behind a trusted TLS reverse proxy (trusts X-Forwarded-For).
BEHIND_PROXY=false
# Set true to reject non-HTTPS requests (enable behind a TLS-terminating proxy).
ENFORCE_HTTPS=false

