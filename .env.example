APP_NAME=Airway Assessment API
APP_VERSION=2.1.0
DEBUG=false

MONGO_URL=mongodb://mongo:27017
MONGO_DB=airway_db

# Use a strong random secret (e.g. `openssl rand -hex 32`). Required in production.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Session idle logout (server-enforced). Idle = no authenticated requests.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_WARNING_SECONDS=120
SESSION_TOUCH_INTERVAL_SECONDS=60

LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
# Per-attempt HTTP timeout (SDK retries disabled; this is the only per-attempt bound).
LLM_TIMEOUT=12
LLM_RETRIES=1
# Hard cap for the whole summary+recommendations step (run in parallel).
# On overrun the API returns canned fallback text instead of hanging.
# Keep below the clients' 45s abort timeout.
LLM_REPORT_BUDGET_SECONDS=28
# Set false to disable the external LLM (falls back to canned clinical text).
LLM_EXTERNAL_ENABLED=true

MODEL_CHECKPOINT=checkpoints/tabular_best.pt
MODEL_DEVICE=cpu
# Fail startup when the checkpoint is missing/mismatched (keep true in prod).
MODEL_REQUIRED=true
# Softmax temperature. Label smoothing keeps logits calibrated; 1.0 = no scaling.
MODEL_SOFTMAX_TEMPERATURE=1.0

# Set true only behind a trusted TLS reverse proxy (trusts X-Forwarded-For).
BEHIND_PROXY=false
# Set true to reject non-HTTPS requests (enable behind a TLS-terminating proxy).
ENFORCE_HTTPS=false


# Image analysis (optional upload endpoint). Face model weights are ~6 MB.
# Download yolo26n-face.pt from https://github.com/akanametov/yolo-face/releases
# and leave FACE_MODEL_PATH empty to use ~/.cache/yolo-face/yolo26n-face.pt
FACE_MODEL_PATH=
# Path to the real-patient tabular model (separate from MODEL_CHECKPOINT).
REAL_MODEL_PATH=checkpoints/tabular_real_v1.joblib

# Which model serves /api/predictions: "real" (80 real patients) or "synthetic".
PREDICTION_MODEL=real
